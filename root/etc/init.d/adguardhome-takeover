#!/bin/sh /etc/rc.common
# 状态感知接管触发器：开机时执行 /usr/share/adguardhome/takeover.sh（幂等）
#
# 背景：官方核心包升级会还原 /etc/init.d/adguardhome 为裸 init（apk 的
# @etc/init.d 规则只保护 symlink；opkg 无保护）。本服务 START=15，早于官方
# 裸 init（19）与增强 init（95）：每次开机先接管，再由增强 init 以完整功能
# 启动 AGH —— 核心包升级后自动恢复，无需重装本包。
#
# 手动执行：/etc/init.d/adguardhome-takeover start
#           或直接 sh /usr/share/adguardhome/takeover.sh

START=15

boot() {
	[ -x /usr/share/adguardhome/takeover.sh ] && \
		/bin/sh /usr/share/adguardhome/takeover.sh
}

start() {
	boot "$@"
}

stop() {
	:
}

restart() {
	start "$@"
}

reload() {
	start "$@"
}
