config adguardhome 'config'
	option enabled '0'
	option redirect 'none'
	option dns_hijack '0'
	option sync_local_domain '1'
	option sync_local_ptr '1'
	option config_file '/etc/adguardhome/adguardhome.yaml'
	option work_dir '/var/lib/adguardhome'
	option bin_path '/usr/bin/AdGuardHome'
	option http_port '3000'
	option logfile ''
	option user 'adguardhome'
	option group 'adguardhome'
	option verbose '0'
	option gc '0'
	option maxprocs '0'
	option memlimit '0'
	option release_channel 'stable'
	option web_username 'admin'
	option web_password ''
	option backup_path '/etc/adguardhome'
	option keep_files ''
	option backup_files ''
	option crontab ''
	option autoupdate_freq ''
	option cutquerylog_freq ''
	option cutruntimelog_freq ''
	option autohost_freq ''
	option watch_iface ''
	option download_links ''
	# 劫持/重定向作用的防火墙 zone，可多个（每行一个）
	list redirect_zone 'lan'
